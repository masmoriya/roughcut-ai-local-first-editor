{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window IPC, events, and native dialogs. Preview uses the separate local media allowlist.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
